{
  "name": "class-central-sync",
  "version": "1.0.0",
  "description": "Fetches Class Central course recommendations for freeCodeCamp News posts and writes them to a JSON cache in DigitalOcean Spaces for the news build",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.6",
  "main": "src/run.js",
  "scripts": {
    "start": "node ./src/run.js",
    "dry-run": "node ./scripts/dry-run.mjs",
    "spaces-check": "node ./scripts/spaces-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run /^lint:/",
    "lint:code": "eslint . --cache",
    "lint:pretty": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/freeCodeCamp/class-central-sync"
  },
  "license": "BSD-3-Clause",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1124.0",
    "graphql-request": "7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dotenv": "17.4.2",
    "eslint": "10.12.0",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.9",
    "vitest": "5.0.3"
  }
}
